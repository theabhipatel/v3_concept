# Groq (free tier) - chat. Model IDs stay in env, never in code. Check console.groq.com/docs/models.
GROQ_API_KEY=
ABI_CHAT_MODEL=openai/gpt-oss-120b
ABI_FAST_MODEL=openai/gpt-oss-20b
ABI_STT_MODEL=whisper-large-v3-turbo
ABI_GUARD_MODEL=meta-llama/llama-prompt-guard-2-86m

# Gemini (free tier) - embeddings
GEMINI_API_KEY=
ABI_EMBED_MODEL=gemini-embedding-001
ABI_EMBED_DIM=768

# Postgres + pgvector (Neon or Supabase free tier)
DATABASE_URL=

# Optional: raises GitHub API limits when ingesting READMEs
GITHUB_TOKEN=

# Optional: scheduling link for "book a call" (empty = contact form)
BOOKING_URL=
